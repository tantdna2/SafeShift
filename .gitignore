# Local dataset and derived data (keep empty directory placeholders)
/data/raw/**
!/data/raw/.gitkeep
/data/processed/**
!/data/processed/.gitkeep
# Generated full-text manifest and run provenance remain local; regenerate via CLI.
/data/manifests/dataset_manifest.csv
/data/manifests/dataset_manifest.provenance.json
**/InspecSafe-V1/
**/inspecsafe-v1/
/datasets/

# Dataset archives, bulk tables and binary stores
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.parquet
*.arrow
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.lmdb

# Raw media; small shareable figures/fixtures below are explicit exceptions
*.jpg
*.jpeg
*.png
*.webp
*.bmp
*.tif
*.tiff
*.gif
*.mp4
*.avi
*.mov
*.mkv
*.webm

# Model weights and checkpoints
**/checkpoints/
**/weights/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.gguf
*.bin

# Run outputs are local; only reviewed, small figures are tracked
/outputs/**
!/outputs/figures/
!/outputs/figures/**/
!/outputs/figures/*.png
!/outputs/figures/*.jpg
!/outputs/figures/*.jpeg
!/outputs/figures/*.webp
!/outputs/figures/*.svg
!/outputs/figures/*.pdf
!/outputs/figures/*.md
!/outputs/figures/**/.gitkeep
/runs/
/wandb/
/mlruns/
*.log

# Small synthetic or shareable image fixtures only; never dataset samples
!/tests/fixtures/**/
!/tests/fixtures/**/*.png
!/tests/fixtures/**/*.jpg
!/tests/fixtures/**/*.jpeg

# Python environments, caches and build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
*.egg-info/
build/
dist/
.cache/
.ipynb_checkpoints/

# Secrets and machine-specific files
.env
.env.*
!.env.example
*.pem
*.key
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
